{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magnus",
  "version": "0.4.3",
  "identifier": "app.magnus.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Magnus", "width": 1200, "height": 840, "minWidth": 720, "minHeight": 520 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Productivity",
    "shortDescription": "Your Magnus appliance: tasks, inbox and evidence.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] } },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
